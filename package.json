{
  "name": "@theharithsa/aroha-mcp",
  "version": "0.1.0",
  "description": "Read-only Aroha Retreat MCP server with scoped REST access and OpenTelemetry",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/cli.mjs && node --check src/server.mjs && node --check src/client.mjs && node --check src/telemetry.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArohaRetreat/mcp.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ArohaRetreat/mcp/issues"
  },
  "homepage": "https://developer.aroharetreat.com/mcp/",
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "zod": "4.6.7"
  },
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "aroha-mcp": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/server.mjs"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/observability.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
